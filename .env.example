# Model providers. Ollama is the local default; use "oci" to restore the
# retained OCI Generative AI adapters.
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# OCI Generative AI (required only when a provider above is set to "oci")
OCI_CONFIG_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=
OCI_ENDPOINT=

# Oracle Database
ORACLE_DB_USER=
ORACLE_DB_PASSWORD=
ORACLE_DB_DSN=
ORACLEVS_TABLE=
ORACLE_CONVERSATION_TABLE=

# API/UI runtime
API_BASE_URL=http://127.0.0.1:8000
# "development" uses API_DEVELOPMENT_USER_ID configured on the server only.
# "required" expects trusted authentication middleware to set request.state.authenticated_identity.
API_AUTH_MODE=development
API_DEVELOPMENT_USER_ID=local-demo-user

# Optional local analytics collection. "noop" is the default; "memory" keeps
# process-local events for the demo analytics view.
ANALYTICS_MODE=noop
